---
import MenuIcon from '@icons/MenuIcon.astro'
import Image from 'astro/components/Image.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getI18n } from '@/i18n/app'
import SpainFlag from '@icons/SpainIcon.astro'
import EnglandFlag from '@icons/EnglandIcon.astro'
import Vacaciones from './Vacaciones.astro'

const local = Astro.currentLocale
const homeUrl = getRelativeLocaleUrl(local, '/')
const aboutUrl = getRelativeLocaleUrl(local, 'about')
const galleryUrl = getRelativeLocaleUrl(local, 'gallery')

const i18 = getI18n(local)
---

<header class="header__container">
  <nav class='desktop__navbar'>
    <ul class="nav__list">
      <li><a class='desk__btn' href={homeUrl}>{i18.HEADER__MENU_Home}</a></li>
      <li><a class='desk__btn' href={aboutUrl}>{i18.HEADER__MENU_About}</a></li>
      <li><a class='desk__btn' href={galleryUrl}>{i18.HEADER__MENU_Gallery}</a></li>
    </ul>
    <div class="lang__switch">
      {
        local === 'es' && (
          <a href={getRelativeLocaleUrl('en', '/')} class='desk__btn flag' title="Change to English">
            <EnglandFlag />
          </a>
        )
      }
      {
        local === 'en' && (
          <a href={getRelativeLocaleUrl('es', '/')} class='desk__btn flag' title="Cambiar a Español">
            <SpainFlag />
          </a>
        )
      }
    </div>
  </nav>
</header>

<div class='hero__container'>
  <button id='openMobile' aria-label='Open mobile menu' class="menu__toggle">
    <MenuIcon width={32} height={32} />
  </button>

  <Image
    loading='eager'
    fetchpriority='high'
    class='logo'
    src='/images/logo.webp'
    width='1739'
    height='794'
    alt='Logo de Asadero Palacio'
  />

  <div class="hero__content">
    <h1>{i18.HEADER__TITLE}</h1>
    <p>{i18.HEADER__DESC}</p>
    <!-- <Vacaciones /> -->
  </div>

  <nav id='mobile__navbar' class='mobile__navbar'>
    <div class="mobile__header">
      <button id="closeMobile" aria-label="Close mobile menu" class="menu__close">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <ul class="mobile__nav__list">
      <li><a class='mobile__btn' href={homeUrl}>{i18.HEADER__MENU_Home}</a></li>
      <li><a class='mobile__btn' href={aboutUrl}>{i18.HEADER__MENU_About}</a></li>
      <li><a class='mobile__btn' href={galleryUrl}>{i18.HEADER__MENU_Gallery}</a></li>
    </ul>
    <div class="mobile__lang__switch">
      {
        local === 'es' && (
          <a href={getRelativeLocaleUrl('en', '/')} class='flag'>
            <EnglandFlag /> <span class="lang-text">English</span>
          </a>
        )
      }
      {
        local === 'en' && (
          <a href={getRelativeLocaleUrl('es', '/')} class='flag'>
            <SpainFlag /> <span class="lang-text">Español</span>
          </a>
        )
      }
    </div>
  </nav>
  <div id="mobile__overlay" class="mobile__overlay"></div>
</div>

<script src='../js/mobile.js'></script>

<style>
  /* Variables */
  :root {
    --nav-height: 4rem;
    --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-fast: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Animations */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Desktop Navbar - Floating Pill */
  .header__container {
    position: fixed;
    top: 1.5rem;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 100;
    pointer-events: none; /* Let clicks pass through container */
  }

  .desktop__navbar {
    display: none;
    pointer-events: auto;
  }

  /* Hero Section */
  .hero__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    padding-top: 4rem; /* Space for the floating button/nav */
  }

  .menu__toggle {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 90;
    background: rgba(104, 21, 21, 0.85); /* clr-primary glass */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 3.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.4s ease, transform 0.3s ease, box-shadow 0.4s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2), 0 2px 4px -1px rgba(0, 0, 0, 0.1);
    color: var(--clr-text);
  }
  .menu__toggle:hover {
    background: rgba(104, 21, 21, 1);
    transform: scale(1.05);
  }

  /* Mobile Navbar & Overlay */
  .mobile__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-slow);
    z-index: 98;
  }
  .mobile__overlay.show {
    opacity: 1;
    visibility: visible;
  }

  .mobile__navbar {
    position: fixed;
    top: 0;
    left: -100%;
    width: min(80vw, 320px);
    height: 100dvh;
    background: linear-gradient(135deg, var(--clr-primary), #4a0f0f);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    z-index: 99;
    display: flex;
    flex-direction: column;
    transition: var(--transition-slow);
    box-shadow: 20px 0 25px -5px rgba(0, 0, 0, 0.5);
    overflow-y: auto;
  }
  .mobile__navbar.show {
    left: 0;
  }

  .mobile__header {
    display: flex;
    justify-content: flex-end;
    padding: 1.5rem;
  }

  .menu__close {
    color: var(--clr-terciary);
    transition: var(--transition-fast);
    padding: 0.5rem;
    border-radius: 50%;
    background: rgba(0,0,0,0.1);
  }
  .menu__close:hover {
    transform: rotate(90deg);
    background: rgba(0,0,0,0.2);
  }

  .mobile__nav__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    padding: 0 2rem;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .mobile__btn {
    font-family: var(--font-primary);
    font-size: var(--size-2xl);
    text-decoration: none;
    color: var(--clr-text);
    display: block;
    position: relative;
    transition: var(--transition-fast);
    width: fit-content;
  }
  .mobile__btn::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--clr-terciary);
    transition: var(--transition-fast);
  }
  .mobile__btn:hover {
    color: var(--clr-terciary);
    transform: translateX(10px);
  }
  .mobile__btn:hover::after {
    width: 100%;
  }

  .mobile__lang__switch {
    margin-top: 3rem;
    padding: 0 2rem 2rem 2rem;
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .mobile__lang__switch .flag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--size-base);
    background: rgba(255,255,255,0.1);
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    text-decoration: none;
    color: var(--clr-text);
    transition: var(--transition-fast);
  }
  .mobile__lang__switch .flag:hover {
    background: rgba(255,255,255,0.2);
    transform: translateY(-2px);
  }
  .lang-text {
    font-family: var(--font-secondary);
    color: var(--clr-text);
    font-weight: 600;
  }

  /* Logo & Typography */
  .logo {
    margin-inline: auto;
    width: min(80vw, 250px);
    height: auto;
    aspect-ratio: 1739/794;
    animation: fadeUp 0.8s ease-out forwards;
  }

  .hero__content {
    animation: fadeUp 0.8s ease-out 0.2s both;
    text-align: center;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h1 {
    font-family: var(--font-primary);
    font-size: var(--size-4xl);
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }
  
  p {
    font-family: var(--font-secondary);
    font-size: var(--size-sm);
    color: var(--clr-terciary);
    opacity: 0.9;
  }

  /* MEDIA QUERIES */
  @media (min-width: 475px) {
    h1 {
      font-size: var(--size-5xl);
    }
    p {
      font-size: var(--size-lg);
    }
  }

  @media (min-width: 640px) {
    p {
      font-size: var(--size-xl);
    }
  }

  @media (min-width: 768px) {
    .menu__toggle {
      display: none;
    }
    .mobile__navbar, .mobile__overlay {
      display: none;
    }
    
    .logo {
      width: 300px;
    }

    .desktop__navbar {
      display: flex;
      align-items: center;
      gap: 2rem;
      background: rgba(104, 21, 21, 0.85); /* clr-primary frosted glass */
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 0.75rem 2rem;
      border-radius: 9999px;
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
      animation: fadeUp 0.5s ease-out forwards;
      transition: background 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
    }

    .nav__list {
      display: flex;
      list-style: none;
      gap: 2rem;
      align-items: center;
    }

    .desk__btn {
      font-family: var(--font-secondary);
      font-size: var(--size-base);
      color: var(--clr-text); /* Warm readable text color */
      font-weight: 600; /* Made slightly bolder for legibility */
      text-decoration: none;
      position: relative;
      padding: 0.5rem 0;
      transition: color 0.3s ease;
    }

    .desk__btn::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 0;
      height: 2px;
      background-color: var(--clr-terciary);
      transition: all 0.3s ease;
      transform: translateX(-50%);
    }

    .desk__btn:hover {
      color: var(--clr-terciary);
    }

    .desk__btn:hover::after {
      width: 100%;
    }

    .lang__switch {
      display: flex;
      align-items: center;
      padding-left: 2rem;
      border-left: 1px solid rgba(255,255,255,0.1);
    }

    .flag {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      background: rgba(255,255,255,0.05);
      transition: var(--transition-fast);
      padding: 0;
    }
    .flag::after {
      display: none; /* No underline for flag */
    }
    .flag:hover {
      background: rgba(255,255,255,0.15);
      transform: scale(1.1);
    }
    .flag svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .logo {
      width: 350px;
      margin-top: 2rem;
    }
    h1 {
      font-size: var(--size-6xl);
    }
    p {
      font-size: var(--size-2xl);
    }
  }

  @media (min-width: 1280px) {
    .logo {
      width: 400px;
    }
    h1 {
      font-size: var(--size-7xl);
    }
    p {
      font-size: var(--size-3xl);
    }
  }
</style>
